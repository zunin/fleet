{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process annotated dependencies",
      fileMatch: [
        "(^|/).+\\.env$",
        "(^|/).+\\.sh$",
        "(^|/).+\\.ya?ml(?:\\.j2)?$",
      ],
      matchStrings: [
        // # renovate: datasource=github-releases depName=k3s-io/k3s
        // k3s_release_version: &version v1.29.0+k3s1
        // # renovate: datasource=helm depName=cilium repository=https://helm.cilium.io
        // version: 1.15.1
        // # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
        // KUBERNETES_VERSION=v1.31.1
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        // # renovate: datasource=docker depName=ghcr.io/prometheus-operator/prometheus-operator
        // https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.80.0/example/prometheus-operator-crd/monitoring.coreos.com_alertmanagerconfigs.yaml
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: "Pin nixpkgs commits used as nixery image tags",
      fileMatch: [
        "(^|/).+\\.ya?ml(?:\\.j2)?$",
      ],
      matchStrings: [
        // # renovate: datasource=git-refs packageName=NixOS/nixpkgs ref=nixos-unstable
        // image: nixery.dev/shell/rsgain:55bfb4d7437bd4e09ab7cba58a43bd68eb310044
        "datasource=(?<datasource>git-refs) packageName=(?<packageName>\\S+) ref=(?<currentValue>\\S+)\\n.+nixery\\.dev/\\S+:(?<currentDigest>[0-9a-f]{40})",
      ],
      datasourceTemplate: "git-refs",
      packageNameTemplate: "https://github.com/{{packageName}}",
    },
    {
      customType: "regex",
      description: "Digest-pinned single-line zunin image refs (raw manifests, e.g. cronjobs)",
      fileMatch: [
        "(^|/).+\\.ya?ml(?:\\.j2)?$",
      ],
      matchStrings: [
        // # renovate: datasource=docker
        // image: ghcr.io/zunin/hister:0.20.0@sha256:0123abc...(64 hex)
        // (kro Application CRs use the generic annotated-deps manager above:
        //  depName= annotation + separate `tag: <version>@sha256:<digest>` line)
        "# renovate: datasource=docker\\n\\s*image:\\s*(?<depName>ghcr\\.io/zunin/[a-z0-9-]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})",
      ],
      datasourceTemplate: "docker",
    },
  ],
}
