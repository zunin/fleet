{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>zunin/fleet//.renovate/customManagers.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Copenhagen)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
  ],
  packageRules: [
    {
      // For our nix-built images (ghcr.io/zunin/*) pin the mutable
      // <version>@sha256:<digest> (bare version + digest). Run-suffixed
      // tags are invisible to renovate (prerelease sorting + immutable
      // digests), so <version>-<run>@sha256 pins never get updates.
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/zunin/*"],
      allowedVersions: "/^\\d+\\.\\d+(\\.\\d+)?(-\\d+)?$/",
      prBodyNotes: [
        "Built from https://github.com/zunin/nix-images. Digest-only updates are base/OS (nixpkgs) rebuilds of the same app version — the image's `dev.zunin.nixpkgs-revision` label identifies the stack, and the daily flake.lock bump PR (renovate nix manager) in that repo carries the upstream nixpkgs change.",
      ],
    },
  ],
  flux: {
    fileMatch: ["(^|/)kubernetes/.+\\.ya?ml$"]
  },
  "helm-values": {
    fileMatch: ["(^|/)kubernetes/.+\\.ya?ml$"]
  },
  kubernetes: {
    fileMatch: ["(^|/)kubernetes/.+\\.ya?ml$"]
  },
}
