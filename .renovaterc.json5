{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>zunin/fleet//.renovate/customManagers.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Copenhagen)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  // Older commits on long-lived update branches used this previous account
  // email. Treating them as manual edits makes Renovate override merged PRs
  // and recreate identical digest updates on every run.
  gitIgnoredAuthors: ["nikolai@oellegaard.dk"],
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
  ],
  packageRules: [
    {
      // For our nix-built images (ghcr.io/zunin/*) pin the mutable
      // <version>@sha256:<digest> (bare version + digest). Run-suffixed
      // tags are invisible to renovate (prerelease sorting + immutable
      // digests), so <version>-<run>@sha256 pins never get updates.
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/zunin/*"],
      allowedVersions: "/^\\d+\\.\\d+(\\.\\d+)?(-\\d+)?$/",
      prBodyNotes: [
        "Built from https://github.com/zunin/nix-images. Digest-only updates are base/OS (nixpkgs) rebuilds of the same app version — the image's `dev.zunin.nixpkgs-revision` label identifies the stack, and the daily flake.lock bump PR (renovate nix manager) in that repo carries the upstream nixpkgs change.",
      ],
    },
    {
      // A header-only bump does not upgrade Flux. The bot-packaged helper
      // downloads a checksum-verified CLI matching the proposed release.
      matchManagers: ["flux"],
      matchPackageNames: ["fluxcd/flux2"],
      matchFileNames: ["flux-system/gotk-components.yaml"],
      groupName: null,
      automerge: false,
      rebaseWhen: "behind-base-branch",
      // Native generation would use the preinstalled CLI's own version.
      skipArtifactsUpdate: true,
      postUpgradeTasks: {
        commands: ["update-flux {{{newValue}}}"],
        fileFilters: ["flux-system/gotk-components.yaml"],
        executionMode: "update",
      },
      prBodyNotes: [
        "This PR must include regenerated controller images, CRDs and RBAC, not just the Flux Version header. Review Flux release-specific API migrations before merging.",
      ],
    },
    {
      // Updating the chart upgrades cert-manager's controllers and CRDs together.
      // Keep certificate infrastructure upgrades isolated and manually reviewed.
      matchDatasources: ["helm"],
      matchPackageNames: ["cert-manager"],
      matchFileNames: ["cert-manager/certmanager-helmrelease.yaml"],
      groupName: null,
      automerge: false,
      rebaseWhen: "behind-base-branch",
      prBodyNotes: [
        "Review cert-manager upgrade notes and Kubernetes compatibility before merging. The chart manages controller images and CRDs; no separate image bumps are needed.",
      ],
    },
  ],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
}
