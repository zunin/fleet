{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>zunin/fleet//.renovate/customManagers.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Copenhagen)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
  ],
  packageRules: [
    {
      // For our own nix-built images (ghcr.io/zunin/*) only consider the
      // bare version tags; ignore the immutable <version>-<run> tags.
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/zunin/*"],
      allowedVersions: "/^\\d+\\.\\d+(\\.\\d+)?$/",
    },
  ],
  flux: {
    fileMatch: ["(^|/)kubernetes/.+\\.ya?ml$"]
  },
  "helm-values": {
    fileMatch: ["(^|/)kubernetes/.+\\.ya?ml$"]
  },
  kubernetes: {
    fileMatch: ["(^|/)kubernetes/.+\\.ya?ml$"]
  },
}
